diff --git a/libchibicc/lower.c b/libchibicc/lower.c
new file mode 100644
index 0000000..0e8f96e
--- /dev/null
+++ b/libchibicc/lower.c
@@ -0,0 +1,220 @@
+#include "compile.h"
+
+// Forward declaration for recursion.
+static Node *lower_node(CompilerContext *ctx, Node *node);
+
+// Deep-clone a node that has no CST-specific semantics.
+// Returns a new node whose kind and fields are copied,
+// with children lowered recursively.
+static Node *lower_clone(CompilerContext *ctx, Node *node) {
+  Node *n = calloc(1, sizeof(Node));
+  *n = *node;
+  if (n->lhs)  n->lhs  = lower_node(ctx, n->lhs);
+  if (n->rhs)  n->rhs  = lower_node(ctx, n->rhs);
+  if (n->cond) n->cond = lower_node(ctx, n->cond);
+  if (n->then) n->then = lower_node(ctx, n->then);
+  if (n->els)  n->els  = lower_node(ctx, n->els);
+  if (n->init) n->init = lower_node(ctx, n->init);
+  if (n->inc)  n->inc  = lower_node(ctx, n->inc);
+  if (n->body) n->body = lower_node(ctx, n->body);
+  if (n->args) n->args = lower_node(ctx, n->args);
+  if (n->cas_addr) n->cas_addr = lower_node(ctx, n->cas_addr);
+  if (n->cas_old)  n->cas_old  = lower_node(ctx, n->cas_old);
+  if (n->cas_new)  n->cas_new  = lower_node(ctx, n->cas_new);
+  if (n->atomic_expr) n->atomic_expr = lower_node(ctx, n->atomic_expr);
+  // Lower linked-list chains
+  if (n->next) n->next = lower_node(ctx, n->next);
+  if (n->case_next) n->case_next = lower_node(ctx, n->case_next);
+  if (n->default_case) n->default_case = lower_node(ctx, n->default_case);
+  if (n->goto_next) n->goto_next = lower_node(ctx, n->goto_next);
+  return n;
+}
+
+static Node *lower_node(CompilerContext *ctx, Node *node) {
+  if (!node)
+    return NULL;
+
+  switch (node->kind) {
+  // --- CST-only: relation operators (direction preserved) ---
+  case ND_GT: {
+    // A > B  →  B < A
+    Node *lhs = lower_node(ctx, node->lhs);
+    Node *rhs = lower_node(ctx, node->rhs);
+    return new_binary(ND_LT, rhs, lhs, node->tok);
+  }
+  case ND_GE: {
+    // A >= B  →  B <= A
+    Node *lhs = lower_node(ctx, node->lhs);
+    Node *rhs = lower_node(ctx, node->rhs);
+    return new_binary(ND_LE, rhs, lhs, node->tok);
+  }
+
+  // --- CST-only: unary plus ---
+  case ND_UPLUS:
+    // +x  →  x
+    return lower_node(ctx, node->lhs);
+
+  // --- CST-only: subscript ---
+  case ND_SUBSCRIPT: {
+    // a[b]  →  *(a + b)
+    Node *lhs = lower_node(ctx, node->lhs);
+    Node *rhs = lower_node(ctx, node->rhs);
+    Node *add = new_add(ctx, lhs, rhs, node->tok);
+    return new_unary(ND_DEREF, add, node->tok);
+  }
+
+  // --- CST-only: arrow ---
+  case ND_ARROW: {
+    // a->b  →  (*a).b
+    Node *lhs = lower_node(ctx, node->lhs);
+    Node *deref = new_unary(ND_DEREF, lhs, node->tok);
+    Node *member = new_unary(ND_MEMBER, deref, node->tok);
+    member->member = node->member;
+    return member;
+  }
+
+  // --- CST-only: prefix ++ / -- ---
+  case ND_PRE_INC: {
+    // ++i  →  to_assign(new_add(i, 1))
+    Node *op = lower_node(ctx, node->lhs);
+    return to_assign(ctx, new_add(ctx, op, new_num(1, node->tok), node->tok));
+  }
+  case ND_PRE_DEC: {
+    // --i  →  to_assign(new_sub(i, 1))
+    Node *op = lower_node(ctx, node->lhs);
+    return to_assign(ctx, new_sub(ctx, op, new_num(1, node->tok), node->tok));
+  }
+
+  // --- CST-only: postfix ++ / -- ---
+  case ND_POST_INC: {
+    // i++  →  (typeof i)((i += 1) - 1)
+    Node *op = lower_node(ctx, node->lhs);
+    add_type(ctx, op);
+    return new_inc_dec(ctx, op, node->tok, 1);
+  }
+  case ND_POST_DEC: {
+    // i--  →  (typeof i)((i -= 1) + 1)
+    Node *op = lower_node(ctx, node->lhs);
+    add_type(ctx, op);
+    return new_inc_dec(ctx, op, node->tok, -1);
+  }
+
+  // --- CST-only: compound assignment ---
+  case ND_COMPOUND_ASSIGN: {
+    // lhs op= rhs  →  to_assign(new_binary(op, lhs, rhs))
+    Node *lhs = lower_node(ctx, node->lhs);
+    Node *rhs = lower_node(ctx, node->rhs);
+    Node *bin = new_binary(node->comp_op, lhs, rhs, node->tok);
+    return to_assign(ctx, bin);
+  }
+
+  // --- CST-only: GNU omitted-middle ternary ---
+  case ND_COND_OMIT: {
+    // a ?: b  →  ({ tmp = a; tmp ? tmp : b; })
+    Node *cond = lower_node(ctx, node->lhs);
+    add_type(ctx, cond);
+    Obj *var = new_lvar(ctx, "", cond->ty);
+    Node *assign = new_binary(ND_ASSIGN, new_var_node(var, node->tok), cond, node->tok);
+    Node *ternary = new_node(ND_COND, node->tok);
+    ternary->cond = new_var_node(var, node->tok);
+    ternary->then = new_var_node(var, node->tok);
+    ternary->els  = lower_node(ctx, node->rhs);
+    return new_binary(ND_COMMA, assign, ternary, node->tok);
+  }
+
+  // --- CST-only: while ---
+  case ND_WHILE: {
+    // while(cond) body  →  for(; cond; ) body
+    Node *n = new_node(ND_FOR, node->tok);
+    n->init = NULL;
+    n->cond = lower_node(ctx, node->cond);
+    n->inc  = NULL;
+    n->then = lower_node(ctx, node->then);
+    n->brk_label = node->brk_label;
+    n->cont_label = node->cont_label;
+    return n;
+  }
+
+  // --- CST-only: break ---
+  case ND_BREAK: {
+    // break →  goto unique_label
+    Node *n = new_node(ND_GOTO, node->tok);
+    n->unique_label = node->label; // stored in label field by parser
+    return n;
+  }
+
+  // --- CST-only: continue ---
+  case ND_CONTINUE: {
+    // continue →  goto unique_label
+    Node *n = new_node(ND_GOTO, node->tok);
+    n->unique_label = node->label;
+    return n;
+  }
+
+  // --- CST-only: parentheses ---
+  case ND_PAREN:
+    // (expr)  →  expr
+    return lower_node(ctx, node->lhs);
+
+  // --- CST-only: empty statement ---
+  case ND_EMPTY_STMT:
+    // ;  →  {} (empty block)
+    return new_node(ND_BLOCK, node->tok);
+
+  // --- CST-only: sizeof ---
+  case ND_SIZEOF: {
+    // sizeof(type/expr)  →  ND_NUM(size) or VLA runtime expression
+    Type *ty;
+    if (node->is_type_operand) {
+      ty = node->sizeof_ty;
+    } else {
+      Node *expr = lower_node(ctx, node->lhs);
+      add_type(ctx, expr);
+      ty = expr->ty;
+    }
+
+    // VLA sizeof: the parser already stored the runtime expression in lhs.
+    if (ty->kind == TY_VLA) {
+      if (node->lhs)
+        return lower_node(ctx, node->lhs);
+      // Fallback: VLA type without pre-computed size (shouldn't happen).
+      return new_num(0, node->tok);
+    }
+    return new_num(ty->size, node->tok);
+  }
+
+  // --- CST-only: _Alignof ---
+  case ND_ALIGNOF: {
+    Type *ty;
+    if (node->is_type_operand) {
+      ty = node->sizeof_ty;
+    } else {
+      Node *expr = lower_node(ctx, node->lhs);
+      add_type(ctx, expr);
+      ty = expr->ty;
+    }
+    return new_num(ty->align, node->tok);
+  }
+
+  // --- CST-only: enum constant reference ---
+  case ND_ENUM_REF:
+    // RED  →  ND_NUM(val)
+    return new_num(node->enum_val, node->tok);
+
+  // --- All other nodes: deep-clone with lowered children ---
+  default:
+    return lower_clone(ctx, node);
+  }
+}
+
+// Lower a whole translation unit: walk the global object list and
+// lower each function body. Returns the lowered AST (same Obj list
+// structure, but all CST kinds replaced).
+Obj *lower_cst_to_ast(CompilerContext *ctx, Obj *cst_globals) {
+  for (Obj *var = cst_globals; var; var = var->next) {
+    if (var->is_function && var->body) {
+      var->body = lower_node(ctx, var->body);
+    }
+  }
+  return cst_globals;
+}
