+static Node *parse_postfix(Token **rest, Token *tok) {
+  Node *node = parse_primary(&tok, tok);
+
+  for (;;) {
+    PostfixInfo *op = find_postfixop(tok);
+    if (!op)
+      break;
+
+    if (op->action == POST_FUNCALL) {
+      // Function call binds tighter than every binary operator.
+      node = funcall(&tok, tok->next, node);
+      continue;
+    }
+
+    if (op->action == POST_SUBSCRIPT) {
+      // `x[y]` is lowered to `*(x+y)`.
+      Token *start = tok;
+      Node *idx = expr(&tok, tok->next);
+      tok = skip(tok, "]");
+      node = new_unary(ND_DEREF, new_add(node, idx, start), start);
+      continue;
+    }
+
+    if (op->action == POST_MEMBER) {
+      // Direct member access keeps the base object intact.
+      node = struct_ref(node, tok->next);
+      tok = tok->next->next;
+      continue;
+    }
+
+    if (op->action == POST_ARROW) {
+      // `x->y` is lowered to `(*x).y`.
+      node = new_unary(ND_DEREF, node, tok);
+      node = struct_ref(node, tok->next);
+      tok = tok->next->next;
+      continue;
+    }
+
+    if (op->action == POST_INC) {
+      // Postfix increment/decrement must preserve the original value.
+      node = new_inc_dec(node, tok, 1);
+      tok = tok->next;
+      continue;
+    }
+
+    if (op->action == POST_DEC) {
+      node = new_inc_dec(node, tok, -1);
+      tok = tok->next;
+      continue;
+    }
+  }
+
+  *rest = tok;
+  return node;
+}
+
+static Node *parse_prefix(Token **rest, Token *tok) {
+  PrefixInfo *op = find_prefixop(tok);
+  if (op) {
+    switch (op->action) {
+    case PFX_NOP:
+      // Unary `+` is a no-op.
+      return parse_prefix(rest, tok->next);
+    case PFX_NEG:
+      // Unary minus is just a node wrapper around the recursive operand.
+      return new_unary(ND_NEG, parse_prefix(rest, tok->next), tok);
+    case PFX_ADDR: {
+      // `&` needs type information so we can reject bitfields.
+      Node *lhs = parse_prefix(rest, tok->next);
+      add_type(lhs);
+      if (lhs->kind == ND_MEMBER && lhs->member->is_bitfield)
+        error_tok(tok, "cannot take address of bitfield");
+      return new_unary(ND_ADDR, lhs, tok);
+    }
+    case PFX_DEREF: {
+      // Dereferencing a function pointer is a C oddity: `*foo` is still
+      // `foo` when `foo` has function type.
+      Node *node = parse_prefix(rest, tok->next);
+      add_type(node);
+      if (node->ty->kind == TY_FUNC)
+        return node;
+      return new_unary(ND_DEREF, node, tok);
+    }
+    case PFX_NOT:
+      // Logical not and bitwise not are simple unary wrappers.
+      return new_unary(ND_NOT, parse_prefix(rest, tok->next), tok);
+    case PFX_BITNOT:
+      return new_unary(ND_BITNOT, parse_prefix(rest, tok->next), tok);
+    case PFX_PREINC:
+      // `++i` is lowered to `i += 1` so later passes only need assignment.
+      return to_assign(new_add(parse_prefix(rest, tok->next), new_num(1, tok), tok));
+    case PFX_PREDEC:
+      // `--i` follows the same lowering as `++i`.
+      return to_assign(new_sub(parse_prefix(rest, tok->next), new_num(1, tok), tok));
+    case PFX_LABELVAL: {
+      // GNU labels-as-values are captured directly as a node.
+      Node *node = new_node(ND_LABEL_VAL, tok);
+      node->label = get_ident(tok->next);
+      node->goto_next = gotos;
+      gotos = node;
+      *rest = tok->next->next;
+      return node;
+    }
+    }
+  }
+
+  if (equal(tok, "(") && is_typename(tok->next)) {
+    // Casts and compound literals both start with `(type ...)`, so the parser
+    // must peek ahead to decide whether this is a cast or a grouped expression.
+    Token *start = tok;
+    Type *ty = typename(&tok, tok->next);
+    tok = skip(tok, ")");
+
+    if (equal(tok, "{")) {
+      // Compound literal. Globals become anonymous globals; locals become a
+      // temp + comma expression so the initializer can be emitted as code.
+      if (scope->next == NULL) {
+        Obj *var = new_anon_gvar(ty);
+        gvar_initializer(rest, tok, var);
+        return new_var_node(var, start);
+      }
+
+      Obj *var = new_lvar("", ty);
+      Node *lhs = lvar_initializer(rest, tok, var);
+      Node *rhs = new_var_node(var, tok);
+      return new_binary(ND_COMMA, lhs, rhs, start);
+    }
+
+    Node *node = new_cast(parse_prefix(rest, tok), ty);
+    node->tok = start;
+    return node;
+  }
+
+  return parse_postfix(rest, tok);
+}
