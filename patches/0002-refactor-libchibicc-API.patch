diff --git a/Makefile b/Makefile
index c22748c..31d53cc 100644
--- a/Makefile
+++ b/Makefile
@@ -1,17 +1,29 @@
 CFLAGS=-std=c11 -g -fno-common -Wall -Wno-switch
 
-SRCS=$(wildcard *.c)
-OBJS=$(SRCS:.c=.o)
+# Library sources (under libchibicc/)
+LIB_DIR=libchibicc
+LIB_SRCS=$(LIB_DIR)/strings.c $(LIB_DIR)/hashmap.c $(LIB_DIR)/unicode.c \
+         $(LIB_DIR)/type.c $(LIB_DIR)/tokenize.c $(LIB_DIR)/preprocess.c \
+         $(LIB_DIR)/parse.c $(LIB_DIR)/compile.c
+LIBOBJS=$(LIB_SRCS:.c=.o)
+
+# Executable sources (in root)
+EXE_SRCS=main.c codegen.c
+EXEOBJS=$(EXE_SRCS:.c=.o)
 
 TEST_SRCS=$(wildcard test/*.c)
 TESTS=$(TEST_SRCS:.c=.exe)
 
 # Stage 1
 
-chibicc: $(OBJS)
+chibicc: $(EXEOBJS) libchibicc.a
 	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)
 
-$(OBJS): chibicc.h
+libchibicc.a: $(LIBOBJS)
+	ar rcs $@ $^
+
+$(LIBOBJS): $(LIB_DIR)/compile.h
+$(EXEOBJS): chibicc.h
 
 test/%.exe: chibicc test/%.c
 	./chibicc -Iinclude -Itest -c -o test/$*.o test/$*.c
@@ -25,12 +37,15 @@ test-all: test test-stage2
 
 # Stage 2
 
-stage2/chibicc: $(OBJS:%=stage2/%)
+stage2/chibicc: stage2/main.o stage2/codegen.o stage2/libchibicc/libchibicc.a
 	$(CC) $(CFLAGS) -o $@ $^ $(LDFLAGS)
 
+stage2/libchibicc/libchibicc.a: $(LIBOBJS:%=stage2/%)
+	ar rcs $@ $^
+
 stage2/%.o: chibicc %.c
-	mkdir -p stage2/test
-	./chibicc -c -o $(@D)/$*.o $*.c
+	mkdir -p $(@D)
+	./chibicc -c -o $@ $*.c
 
 stage2/test/%.exe: stage2/chibicc test/%.c
 	mkdir -p stage2/test
@@ -44,7 +59,7 @@ test-stage2: $(TESTS:test/%=stage2/test/%)
 # Misc.
 
 clean:
-	rm -rf chibicc tmp* $(TESTS) test/*.s test/*.exe stage2
+	rm -rf chibicc tmp* $(TESTS) test/*.s test/*.exe stage2 libchibicc.a
 	find * -type f '(' -name '*~' -o -name '*.o' ')' -exec rm {} ';'
 
 .PHONY: test clean test-stage2
