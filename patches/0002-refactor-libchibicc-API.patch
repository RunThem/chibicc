+  bool          preprocess_only;  // Stop after preprocessing
+  jmp_buf       error_jmp;        // setjmp/longjmp buffer
+};
+
+typedef struct {
+  Token *tokens;      // Always holds token stream
+  Obj   *asts;        // AST on success (after parse)
+  int    code;        // 0 = success, non-zero = error
+  char  *msg;         // Error message
+} CompileResult;
+
+CompileResult compile(CompilerOptions *opt);
+void compile_options_add_include(CompilerOptions *opt, const char *path);
+void compile_options_add_include_file(CompilerOptions *opt, const char *path);
+void compile_options_define(CompilerOptions *opt, const char *define);
+void compile_options_undefine(CompilerOptions *opt, const char *name);
+
+//
+// hashmap.c
+//
+
+typedef struct {
+  char *key;
+  int keylen;
+  void *val;
+} HashEntry;
+
+typedef struct {
+  HashEntry *buckets;
+  int capacity;
+  int used;
+} HashMap;
+
+#endif
diff --git a/libchibicc/compile.c b/libchibicc/compile.c
new file mode 100644
index 0000000..2203360
--- /dev/null
+++ b/libchibicc/compile.c
@@ -0,0 +1,105 @@
+#include "compile.h"
+
+// Global pointer to current compiler options, used by error functions.
+CompilerOptions *current_opts;
+
+void compile_options_add_include(CompilerOptions *opt, const char *path) {
+  strarray_push(&opt->include_paths, strdup(path));
+}
+
+void compile_options_add_include_file(CompilerOptions *opt, const char *path) {
+  strarray_push(&opt->include_files, strdup(path));
+}
+
+void compile_options_define(CompilerOptions *opt, const char *define) {
+  strarray_push(&opt->defines, strdup(define));
+}
+
+void compile_options_undefine(CompilerOptions *opt, const char *name) {
+  strarray_push(&opt->undefines, strdup(name));
+}
+
+static void apply_user_defines(CompilerOptions *opt) {
+  for (int i = 0; i < opt->defines.len; i++) {
+    char *str = opt->defines.data[i];
+    char *eq = strchr(str, '=');
+    if (eq)
+      define_macro(strndup(str, eq - str), eq + 1);
+    else
+      define_macro(str, "1");
+  }
+
+  for (int i = 0; i < opt->undefines.len; i++)
+    undef_macro(opt->undefines.data[i]);
+}
+
+CompileResult compile(CompilerOptions *opt) {
+  CompileResult result = {0};
+  current_opts = opt;
+
+  if (setjmp(opt->error_jmp) == 0) {
+    // 1. Initialize predefined macros
+    init_macros();
+
+    // 2. Apply user-defined macros (override same-named predefined macros)
+    apply_user_defines(opt);
+
+    // 3. Tokenize the main source file
+    Token *tok = tokenize_file((char *)opt->source_path);
+    if (!tok) {
+      result.code = 1;
+      result.msg = format("%s: cannot open file", opt->source_path);
+      current_opts = NULL;
+      return result;
+    }
+
+    // 4. Prepend -include files
+    for (int i = 0; i < opt->include_files.len; i++) {
+      Token *tok2 = tokenize_file(opt->include_files.data[i]);
+      if (!tok2) {
+        result.code = 1;
+        result.msg = format("%s: cannot open file", opt->include_files.data[i]);
+        current_opts = NULL;
+        return result;
+      }
+      // Append main tokens to the end of included file tokens
+      Token *t = tok2;
+      while (t->next->kind != TK_EOF)
+        t = t->next;
+      t->next = tok;
+      tok = tok2;
+    }
+
+    result.tokens = tok;
+
+    // 5. Preprocess-only mode
+    if (opt->preprocess_only) {
+      tok = preprocess(tok, opt);
+      result.tokens = tok;
+      current_opts = NULL;
+      return result;
+    }
+
+    // 6. Preprocess
+    tok = preprocess(tok, opt);
+    result.tokens = tok;
+
+    // 7. Tokenize-only mode (after preprocessing)
+    if (opt->tokenize_only) {
+      current_opts = NULL;
+      return result;
+    }
+
+    // 8. Parse
+    result.asts = parse(tok);
+    result.code = 0;
+    current_opts = NULL;
+    return result;
+  }
+
+  // Error path: longjmp from error_tok/error_at
+  result.code = 1;
+  result.msg = get_compile_error_msg();
+  current_opts = NULL;
+  return result;
+}
