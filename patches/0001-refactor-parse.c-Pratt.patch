+static Node *parse_binary_rhs(Node *lhs, Token **rest, Token *tok, OpInfo *op) {
+  Token *start = tok;
+  Token *rhs_tok = tok->next;
+  // Left-associative operators parse the right-hand side with a slightly
+  // higher minimum binding power. Assignment-like operators stay at the same
+  // binding power so they remain right-associative.
+  int rhs_bp = (op->action == OP_ASSIGN || op->action == OP_TO_ASSIGN) ? op->bp : op->bp + 1;
+  Node *rhs = parse_expr_bp(rest, rhs_tok, rhs_bp);
+
+  if (op->action == OP_ASSIGN)
+    return new_binary(ND_ASSIGN, lhs, rhs, start);
+
+  if (op->action == OP_TO_ASSIGN) {
+    Node *node;
+    if (op->kind == ND_ADD)
+      node = new_add(lhs, rhs, start);
+    else if (op->kind == ND_SUB)
+      node = new_sub(lhs, rhs, start);
+    else
+      node = new_binary(op->kind, lhs, rhs, start);
+    return to_assign(node);
+  }
+
+  if (op->kind == ND_ADD)
+    return new_add(lhs, rhs, start);
+
+  if (op->kind == ND_SUB)
+    return new_sub(lhs, rhs, start);
+
+  if (op->swap)
+    return new_binary(op->kind, rhs, lhs, start);
+
+  return new_binary(op->kind, lhs, rhs, start);
+}
