+  StringArray   include_paths;    // Header search paths (-I)
+  StringArray   include_files;    // Files to include first (-include)
+  StringArray   defines;          // Custom macros "NAME=value" (-D)
+  StringArray   undefines;        // Macros to undefine (-U)
