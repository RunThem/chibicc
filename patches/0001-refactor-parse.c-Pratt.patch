+static OpInfo *find_binop(Token *tok) {
+  // The tables are intentionally tiny, so linear search keeps the code simple.
+  for (int i = 0; i < sizeof(binops) / sizeof(*binops); i++)
+    if (equal(tok, binops[i].op))
+      return &binops[i];
+  return NULL;
+}
+
+static PrefixInfo *find_prefixop(Token *tok) {
+  // Prefix operators are few enough that a linear scan is clearer than a
+  // bigger dispatch structure.
+  for (int i = 0; i < sizeof(prefixops) / sizeof(*prefixops); i++)
+    if (equal(tok, prefixops[i].op))
+      return &prefixops[i];
+  return NULL;
+}
+
+static PostfixInfo *find_postfixop(Token *tok) {
+  // Same idea as above: keep the operator inventory explicit and local.
+  for (int i = 0; i < sizeof(postfixops) / sizeof(*postfixops); i++)
+    if (equal(tok, postfixops[i].op))
+      return &postfixops[i];
+  return NULL;
+}
 
